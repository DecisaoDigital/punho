<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Descarregar o APK da nova versão em segundo plano. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Instalar a actualização a partir da própria app, em vez de mandar o
         utilizador ao browser e por seis ecrãs do sistema. O Android exige
         ainda que ele autorize explicitamente nas definições — a app abre-as
         quando for preciso, nunca no arranque. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Os dados dos clientes finais não saem deste telemóvel para uma conta
         pessoal.

         Sem `allowBackup="false"`, o Auto Backup do Android copia as
         SharedPreferences da app — onde vivem nomes, telefones, NIF, IBAN e
         NISS — para o Google Drive **pessoal** de quem usa o telemóvel. São
         dados de clientes de uma empresa a aterrar numa conta particular, sem
         base legal nenhuma e sem ninguém o ter pedido.

         As duas linhas são precisas e não se substituem: `allowBackup` trata da
         cópia para a nuvem (e é o que vale até ao Android 11), e
         `dataExtractionRules` trata da transferência directa entre aparelhos no
         Android 12+, que **ignora** o `allowBackup`. Só com as duas é que a
         mudança de telemóvel não leva os dados atrás. -->
    <application
        android:label="punho"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_de_extraccao">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Quem trata o link de recuperação é o `app_links` (por dentro do
                 supabase_flutter), não o Navigator.

                 Sem isto o motor do Flutter entrega o link *também* como rota e
                 tenta `pushNamed('/auth/callback')`. Este MaterialApp só tem
                 `home:` — sem `routes`, sem `onGenerateRoute` — por isso a rota
                 não existe e o `_onUnknownRoute` rebenta com "Null check
                 operator used on a null value" a cada link. Não mata a app: a
                 recuperação corre na mesma até ao fim. Mas atira um erro por
                 cada link, e um erro que se ignora ensina a ignorar os outros.
                 Apanhado no Redmi a 4 de Agosto de 2026 — não aparece em teste
                 nenhum, só no aparelho. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- O link do email de recuperação de palavra-passe.

                 Sem isto, o `redirectTo: 'punho://auth/callback'` que a app
                 manda ao Supabase não valia nada: o Android não sabia a quem
                 entregar `punho://`, e quem carregasse em "Esqueci a
                 palavra-passe" no telemóvel recebia o email e ficava sem
                 caminho de volta à app. Apanhado a 4 de Agosto de 2026, na
                 pele — e o esquema por omissão do projecto é o do POS
                 (`washinvoice://`), que aqui abriria a app errada.

                 Filtro à parte do LAUNCHER de propósito: juntá-los faria da
                 app um alvo do `VIEW` genérico. Quem trata do link é o próprio
                 `supabase_flutter`, que escuta `app_links` e chama
                 `getSessionFromUrl`. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="punho" android:host="auth"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
